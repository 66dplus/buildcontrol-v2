# Bitrix24
BITRIX24_WEBHOOK_URL=https://b24-xxxxx.bitrix24.ru/rest/1/your-webhook-key/
BITRIX24_DOMAIN=b24-xxxxx.bitrix24.ru

# Server
VPS_URL=http://your-vps-ip:8000
LOG_LEVEL=INFO

# Telegram notifications
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-1001234567890
NOTIFICATIONS_ENABLED=false

# Procurement approval workflow
# Bitrix user id who owns the audit task for every purchase request
PURCHASE_APPROVER_USER_ID=1
# Random 32+ char secret used to sign /approval/{id} links (HMAC)
APPROVAL_LINK_SECRET=replace-with-32-char-random-string
# Random secret set on the Telegram webhook (X-Telegram-Bot-Api-Secret-Token header)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string
# Optional: chat id for approver notifications (defaults to TELEGRAM_CHAT_ID)
TELEGRAM_APPROVER_CHAT_ID=
# Max attachment size for commercial proposal uploads (MB)
MAX_PROPOSAL_FILE_MB=10

# SQLite database path (defaults work for VPS; use a local path for dev)
DB_PATH=/opt/buildcontrol/buildcontrol.db

# Director AI agent (Telegram natural-language queries)
# Get key at https://openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
# Model to use (OpenRouter model ID). gpt-4.1-mini is cost-effective for tool use.
OPENROUTER_MODEL=openai/gpt-5.4-mini
# Comma-separated Telegram chat IDs allowed to query the director agent
TELEGRAM_DIRECTOR_CHAT_IDS=753647644
